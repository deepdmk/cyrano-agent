graph TB
    Farmer["FARMER<br/><i>(natural conversation)</i>"]

    subgraph Orchestrator[" "]
        direction TB
        OrchestratorLabel["ORCHESTRATOR"]

        subgraph CyranoBox[" "]
            direction TB
            CyranoLabel["CYRANO (Claude)<br/>Front-of-House Conversation Agent"]
            CyranoDetails["- Listens, follows up, matches energy<br/>- Never advises, praises, or interrogates<br/>- Weaves in questions when embedding distance is close<br/>- Adjusts behavior based on Mood Agent nudges"]
        end

        QuestionsDB["Questions Vector DB<br/><i>(LanceDB)</i><br/><br/>768-dim vectors<br/>Cleared each session"]
        SessionsDB["Sessions Table<br/><i>(Agno SqliteDb)</i><br/><br/>Full conversation<br/>history"]

        subgraph Pipeline["BACKGROUND PIPELINE (after each turn)"]
            direction LR

            ExtractAgent["EXTRACT AGENT<br/><i>(Claude)</i><br/><br/>Reads session<br/>Extracts facts<br/>from natural speech"]

            DataAgent["DATA AGENT<br/><i>(Claude)</i><br/><br/>Routes facts to form DBs<br/>Identifies gaps<br/>Generates questions<br/>with embeddings"]

            MoodAgent["MOOD AGENT<br/><i>(Claude)</i><br/><br/>Detects fatigue,<br/>disengagement,<br/>frustration<br/><br/>Nudges Cyrano to<br/>adjust, wrap up,<br/>or end"]
        end
    end

    MainDB["MAIN DB<br/><i>(SQLite)</i><br/><br/>Permanent store of all facts<br/>extracted from conversation<br/><br/>Written by Extract Agent<br/>Read by Data Agent"]

    subgraph FormDBs["FORM DATABASES (swappable)"]
        direction LR
        AgDB["Agricultural<br/><br/>fields<br/>crops<br/>inputs<br/>yields<br/>weather"]
        SchedDB["Scheduling<br/><br/>events"]
        PlanDB["Planning<br/><br/>plans"]
    end

    Integration["<i>These are integration points.<br/>Swap in any external product:<br/>ag management, market software,<br/>logistics, microfinance, etc.</i>"]

    Farmer -- "speaks" --> CyranoDetails
    CyranoDetails -- "responds" --> Farmer

    CyranoDetails -- "reads questions<br/>(similarity search)" --> QuestionsDB
    CyranoDetails -- "writes session" --> SessionsDB

    SessionsDB -- "reads session" --> ExtractAgent
    SessionsDB -- "reads session" --> MoodAgent

    ExtractAgent -- "facts" --> DataAgent

    ExtractAgent -- "writes facts" --> MainDB
    MainDB -- "reads unrouted facts" --> DataAgent

    DataAgent -- "routes facts" --> FormDBs
    DataAgent -- "writes questions<br/>with embeddings" --> QuestionsDB

    MoodAgent -. "nudges Cyrano" .-> CyranoDetails

    FormDBs --- Integration

    classDef farmer fill:#4a7c59,stroke:#2d5016,color:#fff,font-weight:bold,font-size:14px
    classDef orchestratorLabel fill:none,stroke:none,color:#333,font-weight:bold,font-size:16px
    classDef cyranoLabel fill:#2c5f8a,stroke:#1a3a5c,color:#fff,font-weight:bold,font-size:13px
    classDef cyranoDetail fill:#2c5f8a,stroke:#1a3a5c,color:#fff,font-size:12px
    classDef agent fill:#5b4a8a,stroke:#3d2e6b,color:#fff,font-size:12px
    classDef datastore fill:#8a6d3b,stroke:#5c4726,color:#fff,font-size:12px
    classDef database fill:#3a6b5e,stroke:#1e4a3f,color:#fff,font-size:12px
    classDef formdb fill:#6b5b3a,stroke:#4a3e26,color:#fff,font-size:12px
    classDef note fill:none,stroke:none,color:#666,font-style:italic,font-size:11px
    classDef orchestratorBox fill:#f5f5f5,stroke:#999,stroke-width:2px
    classDef cyranoBox fill:#e8f0f8,stroke:#2c5f8a,stroke-width:2px
    classDef pipelineBox fill:#f0ecf5,stroke:#5b4a8a,stroke-width:2px

    class Farmer farmer
    class OrchestratorLabel orchestratorLabel
    class CyranoLabel cyranoLabel
    class CyranoDetails cyranoDetail
    class ExtractAgent,DataAgent,MoodAgent agent
    class QuestionsDB,SessionsDB datastore
    class MainDB database
    class AgDB,SchedDB,PlanDB formdb
    class Integration note
